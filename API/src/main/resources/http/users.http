@baseUrl = http://localhost:8080/api/users

### Register User 1
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "andrei",
  "password": "password123",
  "firstName": "Andrei",
  "lastName": "Popescu",
  "email": "andrei@example.com"
}

